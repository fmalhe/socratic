{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "socratic",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Disable public *.workers.dev URL so all traffic must go through your Cloudflare Access-protected custom domain
  "workers_dev": false,
  // Replace with your custom domain route in Cloudflare DNS
  "routes": [
    {
      "pattern": "socratic.yourdomain.com",
      "custom_domain": true
    }
  ],
  "containers": [
    {
      "class_name": "SocraticContainer",
      "image": "../Dockerfile",
      // Single instance guarantees SQLite single-writer consistency with Litestream R2 replication
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SOCRATIC",
        "class_name": "SocraticContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SocraticContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
